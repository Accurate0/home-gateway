  "query": "INSERT INTO workflow_pending_timer (workflow, timer_kind, subject_kind, subject_entity, event_id, vars, fire_at) VALUES ($1, $2, $3, $4, $5, $6, $7) ON CONFLICT (workflow, timer_kind) DO UPDATE SET id = gen_random_uuid(), subject_kind = EXCLUDED.subject_kind, subject_entity = EXCLUDED.subject_entity, event_id = EXCLUDED.event_id, vars = EXCLUDED.vars, armed_at = now(), fire_at = EXCLUDED.fire_at RETURNING id, workflow, timer_kind, subject_kind, subject_entity, event_id, vars, fire_at",
