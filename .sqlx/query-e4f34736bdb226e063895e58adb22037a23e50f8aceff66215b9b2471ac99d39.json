{
  "db_name": "PostgreSQL",
  "query": "UPDATE device_intent SET attempts = attempts + 1, last_attempt_at = now() WHERE id IN ( SELECT id FROM device_intent WHERE status = 'pending' AND relative = false AND requested_at < now() - make_interval(secs => $1) AND (last_attempt_at IS NULL OR last_attempt_at < now() - make_interval(secs => $2)) ORDER BY last_attempt_at NULLS FIRST LIMIT $3 FOR UPDATE SKIP LOCKED ) RETURNING id, kind, address, attributes, relative, attempts, event_id, requested_at",
