{
 "uid": "home-gateway",
 "title": "Home Gateway",
 "tags": ["home-gateway"],
 "editable": true,
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "hide": 0,
    "current": {},
    "refresh": 1
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Bus events / sec",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
   "fieldConfig": {
    "defaults": { "unit": "ops", "decimals": 2 },
    "overrides": []
   },
   "targets": [
    { "refId": "A", "expr": "sum(rate(home_gateway_bus_events_total_total[5m]))" }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Workflow success ratio (1h)",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "red", "value": null },
       { "color": "yellow", "value": 0.9 },
       { "color": "green", "value": 0.99 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(home_gateway_workflows_total_total{outcome=\"success\"}[1h])) / clamp_min(sum(increase(home_gateway_workflows_total_total[1h])), 1e-9)"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Trigger fire rate",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
   "fieldConfig": {
    "defaults": { "unit": "ops", "decimals": 2 },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(home_gateway_triggers_total_total{outcome=\"fired\"}[5m]))"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Devices with low battery (<20%)",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "green", "value": null },
       { "color": "yellow", "value": 1 },
       { "color": "red", "value": 3 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(max by (device_id) (home_gateway_device_battery_percent) < 20)"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Bus events by kind",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
   "fieldConfig": {
    "defaults": { "unit": "ops" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (event_kind) (rate(home_gateway_bus_events_total_total[5m]))",
     "legendFormat": "{{event_kind}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Trigger evaluations by outcome",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
   "fieldConfig": {
    "defaults": { "unit": "ops" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(home_gateway_triggers_total_total[5m]))",
     "legendFormat": "{{outcome}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Workflow executions by outcome",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
   "fieldConfig": {
    "defaults": { "unit": "ops" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(home_gateway_workflows_total_total[5m]))",
     "legendFormat": "{{outcome}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Workflow duration (p50 / p95)",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
   "fieldConfig": {
    "defaults": { "unit": "s" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(home_gateway_workflow_duration_seconds_bucket[5m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(home_gateway_workflow_duration_seconds_bucket[5m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Workflow steps by kind",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
   "fieldConfig": {
    "defaults": { "unit": "ops" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (step) (rate(home_gateway_workflow_steps_total_total[5m]))",
     "legendFormat": "{{step}}"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Step errors by kind",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
   "fieldConfig": {
    "defaults": { "unit": "ops" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (step) (rate(home_gateway_workflow_steps_total_total{outcome=\"error\"}[5m]))",
     "legendFormat": "{{step}}"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Device battery percent",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "red", "value": null },
       { "color": "yellow", "value": 20 },
       { "color": "green", "value": 40 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (device_id, kind) (home_gateway_device_battery_percent)",
     "legendFormat": "{{device_id}} ({{kind}})"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "E-ink wake drift (p95)",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
   "fieldConfig": {
    "defaults": { "unit": "s" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, device_id) (rate(home_gateway_eink_wake_drift_seconds_bucket[15m])))",
     "legendFormat": "{{device_id}}"
    }
   ]
  },
  {
   "id": 13,
   "type": "table",
   "title": "Ad-hoc tasks (last 24h)",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
   "fieldConfig": {
    "defaults": { "unit": "short" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (task, outcome) (increase(home_gateway_adhoc_tasks_total_total[24h]))",
     "format": "table",
     "instant": true
    }
   ]
  }
 ]
}
