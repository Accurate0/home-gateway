  {
   "id": 56,
   "type": "table",
   "title": "E-ink check-in traces",
   "description": "The display wakes hourly and POSTs /v1/epd/config, then GETs the image. A gap other than the nightly sleep means it did not wake. Tempo's tag-value lookup drops these low-frequency routes, so query them by TraceQL rather than picking the route from a dropdown.",
   "datasource": { "type": "tempo", "uid": "tempo" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 162 },
   "fieldConfig": {
    "defaults": {},
    "overrides": [
     {
      "matcher": { "id": "byName", "options": "traceID" },
      "properties": [
       {
        "id": "links",
        "value": [
         {
          "title": "Open trace in Explore",
          "targetBlank": true,
          "url": "/explore?orgId=1&schemaVersion=1&panes={\"epd\":{\"datasource\":\"tempo\",\"queries\":[{\"refId\":\"A\",\"datasource\":{\"type\":\"tempo\",\"uid\":\"tempo\"},\"queryType\":\"traceql\",\"query\":\"${__value.raw}\"}],\"range\":{\"from\":\"${__from}\",\"to\":\"${__to}\"}}}"
         }
        ]
       }
      ]
     }
    ]
   },
   "targets": [
    {
     "refId": "A",
     "datasource": { "type": "tempo", "uid": "tempo" },
     "queryType": "traceql",
     "query": "{resource.service.name=\"home-gateway\" && span.http.route=~\"/v1/epd/.*\"}",
     "limit": 50
    }
   ]
  },
