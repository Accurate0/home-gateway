  {
   "id": 13,
   "type": "table",
   "title": "Ad-hoc tasks (last 24h)",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 24, "x": 0, "y": 59 },
   "fieldConfig": {
    "defaults": { "unit": "short" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (task, outcome) (increase(home_gateway_adhoc_tasks_total_total[24h]))",
     "format": "table",
     "instant": true
    }
   ]
  },
  {
   "id": 49,
   "type": "row",
   "title": "Integrations",
   "collapsed": false,
   "gridPos": { "h": 1, "w": 24, "x": 0, "y": 67 },
   "panels": []
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Integration poll outcomes",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 68 },
   "fieldConfig": {
    "defaults": { "unit": "ops" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (integration, outcome) (rate(home_gateway_integration_polls_total_total[15m]))",
     "legendFormat": "{{integration}} ({{outcome}})"
