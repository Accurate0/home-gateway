{
 "uid": "home-gateway",
 "title": "Home Gateway",
 "tags": ["home-gateway"],
 "editable": true,
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "hide": 0,
    "current": {},
    "refresh": 1
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Bus events / sec",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
   "fieldConfig": {
    "defaults": { "unit": "ops", "decimals": 2 },
    "overrides": []
   },
   "targets": [
    { "refId": "A", "expr": "sum(rate(home_gateway_bus_events_total_total[5m]))" }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Workflow success ratio (1h)",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "red", "value": null },
       { "color": "yellow", "value": 0.9 },
       { "color": "green", "value": 0.99 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(home_gateway_workflows_total_total{outcome=\"success\"}[1h])) / clamp_min(sum(increase(home_gateway_workflows_total_total[1h])), 1e-9)"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Trigger fire rate",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
   "fieldConfig": {
    "defaults": { "unit": "ops", "decimals": 2 },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(home_gateway_triggers_total_total{outcome=\"fired\"}[5m]))"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Devices with low battery (<20%)",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "green", "value": null },
       { "color": "yellow", "value": 1 },
       { "color": "red", "value": 3 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(max by (device_id) (home_gateway_device_battery_percent) < 20)"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Bus events by kind",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
   "fieldConfig": {
    "defaults": { "unit": "ops" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (event_kind) (rate(home_gateway_bus_events_total_total[5m]))",
     "legendFormat": "{{event_kind}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Trigger evaluations by outcome",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
   "fieldConfig": {
    "defaults": { "unit": "ops" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(home_gateway_triggers_total_total[5m]))",
     "legendFormat": "{{outcome}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Workflow executions by outcome",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
   "fieldConfig": {
    "defaults": { "unit": "ops" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(home_gateway_workflows_total_total[5m]))",
     "legendFormat": "{{outcome}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Workflow duration (p50 / p95)",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
   "fieldConfig": {
    "defaults": { "unit": "s" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum by (le) (rate(home_gateway_workflow_duration_seconds_bucket[5m])))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum by (le) (rate(home_gateway_workflow_duration_seconds_bucket[5m])))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Workflow steps by kind",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 20 },
   "fieldConfig": {
    "defaults": { "unit": "ops" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (step) (rate(home_gateway_workflow_steps_total_total[5m]))",
     "legendFormat": "{{step}}"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Step errors by kind",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 12, "y": 20 },
   "fieldConfig": {
    "defaults": { "unit": "ops" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (step) (rate(home_gateway_workflow_steps_total_total{outcome=\"error\"}[5m]))",
     "legendFormat": "{{step}}"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Device battery percent",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 28 },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "red", "value": null },
       { "color": "yellow", "value": 20 },
       { "color": "green", "value": 40 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (device_id, kind) (home_gateway_device_battery_percent)",
     "legendFormat": "{{device_id}} ({{kind}})"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "E-ink wake drift (p95)",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 12, "y": 28 },
   "fieldConfig": {
    "defaults": { "unit": "s" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, device_id) (rate(home_gateway_eink_wake_drift_seconds_bucket[15m])))",
     "legendFormat": "{{device_id}}"
    }
   ]
  },
  {
   "id": 13,
   "type": "table",
   "title": "Ad-hoc tasks (last 24h)",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 36 },
   "fieldConfig": {
    "defaults": { "unit": "short" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (task, outcome) (increase(home_gateway_adhoc_tasks_total_total[24h]))",
     "format": "table",
     "instant": true
    }
   ]
  },
  {
   "id": 14,
   "type": "timeseries",
   "title": "Integration poll outcomes",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 12, "y": 36 },
   "fieldConfig": {
    "defaults": { "unit": "ops" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (integration, outcome) (rate(home_gateway_integration_polls_total_total[15m]))",
     "legendFormat": "{{integration}} ({{outcome}})"
    }
   ]
  },
  {
   "id": 15,
   "type": "timeseries",
   "title": "Integration poll duration (p95)",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 44 },
   "fieldConfig": {
    "defaults": { "unit": "s" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, integration) (rate(home_gateway_integration_poll_duration_seconds_bucket[15m])))",
     "legendFormat": "{{integration}}"
    }
   ]
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "MQTT ingest by topic kind",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 12, "y": 44 },
   "fieldConfig": {
    "defaults": { "unit": "ops" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (topic_kind) (rate(home_gateway_mqtt_ingest_total_total[5m]))",
     "legendFormat": "{{topic_kind}}"
    }
   ]
  },
  {
   "id": 17,
   "type": "row",
   "title": "Reliability",
   "collapsed": false,
   "gridPos": { "h": 1, "w": 24, "x": 0, "y": 52 },
   "panels": []
  },
  {
   "id": 18,
   "type": "stat",
   "title": "MQTT ingest rate",
   "description": "Zero means the broker link is dead. Every device report arrives this way.",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 6, "x": 0, "y": 53 },
   "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "background" },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "red", "value": null },
       { "color": "green", "value": 0.01 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(home_gateway_mqtt_ingest_total_total[5m]))"
    }
   ]
  },
  {
   "id": 19,
   "type": "stat",
   "title": "Stale devices",
   "description": "Devices past their watchdog timeout and no longer reporting.",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 6, "x": 6, "y": 53 },
   "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "green", "value": null },
       { "color": "orange", "value": 1 },
       { "color": "red", "value": 3 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(home_gateway_device_stale) or vector(0)"
    }
   ]
  },
  {
   "id": 20,
   "type": "stat",
   "title": "Reconciler give-ups (6h)",
   "description": "Commands abandoned after max_attempts: a device was told to do something and never did.",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 6, "x": 12, "y": 53 },
   "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "green", "value": null },
       { "color": "orange", "value": 1 },
       { "color": "red", "value": 5 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(home_gateway_reconciler_give_ups_total_total[6h])) or vector(0)"
    }
   ]
  },
  {
   "id": 21,
   "type": "stat",
   "title": "Actor restarts (1h)",
   "description": "A sustained non-zero value is a supervised actor in a crash loop.",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 6, "x": 18, "y": 53 },
   "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "green", "value": null },
       { "color": "orange", "value": 1 },
       { "color": "red", "value": 5 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(home_gateway_actor_restarts_total_total[1h])) or vector(0)"
    }
   ]
  },
  {
   "id": 22,
   "type": "timeseries",
   "title": "Reconciler retries vs give-ups",
   "description": "A retry re-drives an unconfirmed command; a give-up means it never landed.",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 57 },
   "fieldConfig": {
    "defaults": { "unit": "ops" },
    "overrides": [
     {
      "matcher": { "id": "byRegexp", "options": "give-up.*" },
      "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
     }
    ]
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind) (rate(home_gateway_reconciler_retries_total_total[15m]))",
     "legendFormat": "retry {{kind}}"
    },
    {
     "refId": "B",
     "expr": "sum by (kind) (rate(home_gateway_reconciler_give_ups_total_total[15m]))",
     "legendFormat": "give-up {{kind}}"
    }
   ]
  },
  {
   "id": 23,
   "type": "table",
   "title": "Time since last report",
   "description": "Worst first. Devices climbing here are about to trip the watchdog.",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 12, "y": 57 },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "instance": true,
       "job": true,
       "namespace": true,
       "pod": true,
       "service": true,
       "container": true,
       "endpoint": true,
       "otel_scope_name": true,
       "otel_scope_version": true
      },
      "renameByName": { "device_id": "Device", "Value": "Silent for" }
     }
    }
   ],
   "fieldConfig": {
    "defaults": { "unit": "s" },
    "overrides": [
     {
      "matcher": { "id": "byName", "options": "Silent for" },
      "properties": [
       { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 900 },
          { "color": "red", "value": 1800 }
         ]
        }
       }
      ]
     }
    ]
   },
   "options": { "sortBy": [{ "displayName": "Silent for", "desc": true }] },
   "targets": [
    {
     "refId": "A",
     "expr": "home_gateway_device_last_seen_age_seconds",
     "instant": true,
     "format": "table"
    }
   ]
  },
  {
   "id": 24,
   "type": "timeseries",
   "title": "Actor restarts by actor and reason",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 65 },
   "fieldConfig": {
    "defaults": { "unit": "short", "custom": { "drawStyle": "bars", "fillOpacity": 30, "stacking": { "mode": "normal" } } },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (actor, reason) (increase(home_gateway_actor_restarts_total_total[15m]))",
     "legendFormat": "{{actor}} / {{reason}}"
    }
   ]
  },
  {
   "id": 25,
   "type": "timeseries",
   "title": "Device handler errors",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 12, "y": 65 },
   "fieldConfig": {
    "defaults": { "unit": "ops" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (handler) (rate(home_gateway_device_handler_errors_total_total[15m]))",
     "legendFormat": "{{handler}}"
    }
   ]
  },
  {
   "id": 26,
   "type": "row",
   "title": "Traces",
   "collapsed": false,
   "gridPos": { "h": 1, "w": 24, "x": 0, "y": 73 },
   "panels": []
  },
  {
   "id": 27,
   "type": "timeseries",
   "title": "Span rate by name",
   "description": "From Tempo's span-metrics generator. This is what the trace volume is made of; watch it after changing sampling.",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 74 },
   "fieldConfig": {
    "defaults": { "unit": "ops", "custom": { "fillOpacity": 20, "stacking": { "mode": "normal" } } },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(15, sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"home-gateway\"}[15m])))",
     "legendFormat": "{{span_name}}"
    }
   ]
  },
  {
   "id": 28,
   "type": "timeseries",
   "title": "Span error ratio",
   "description": "Share of spans reporting STATUS_CODE_ERROR, by span name.",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 12, "y": 74 },
   "fieldConfig": {
    "defaults": { "unit": "percentunit", "min": 0, "max": 1 },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"home-gateway\", status_code=\"STATUS_CODE_ERROR\"}[15m])) or vector(0)) / clamp_min(sum by (span_name) (rate(traces_spanmetrics_calls_total{service=\"home-gateway\"}[15m])), 0.0001)",
     "legendFormat": "{{span_name}}"
    }
   ]
  },
  {
   "id": 29,
   "type": "timeseries",
   "title": "Span latency (p95)",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 82 },
   "fieldConfig": {
    "defaults": { "unit": "s" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "topk(10, histogram_quantile(0.95, sum by (le, span_name) (rate(traces_spanmetrics_latency_bucket{service=\"home-gateway\"}[15m]))))",
     "legendFormat": "{{span_name}}"
    }
   ]
  },
  {
   "id": 30,
   "type": "traces",
   "title": "Recent errored traces",
   "description": "An mqtt ingest error is emitted as its own always-sampled trace, so it survives even when its parent was sampled out.",
   "datasource": { "type": "tempo", "uid": "tempo" },
   "gridPos": { "h": 8, "w": 12, "x": 12, "y": 82 },
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "datasource": { "type": "tempo", "uid": "tempo" },
     "queryType": "traceql",
     "query": "{resource.service.name=\"home-gateway\" && status=error}",
     "limit": 20
    }
   ]
  },
  {
   "id": 31,
   "type": "row",
   "title": "Lua",
   "collapsed": false,
   "gridPos": { "h": 1, "w": 24, "x": 0, "y": 90 },
   "panels": []
  },
  {
   "id": 32,
   "type": "timeseries",
   "title": "Lua execution duration (p50 / p95)",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 91 },
   "fieldConfig": {
    "defaults": { "unit": "ms" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, source) (rate(home_gateway_lua_duration_milliseconds_bucket[15m])))",
     "legendFormat": "p95 {{source}}"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.50, sum by (le, source) (rate(home_gateway_lua_duration_milliseconds_bucket[15m])))",
     "legendFormat": "p50 {{source}}"
    }
   ]
  },
  {
   "id": 33,
   "type": "timeseries",
   "title": "Lua executions by outcome",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
