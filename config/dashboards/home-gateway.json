{
 "uid": "home-gateway",
 "title": "Home Gateway",
 "tags": ["home-gateway"],
 "editable": true,
 "schemaVersion": 39,
 "refresh": "30s",
 "time": {
  "from": "now-6h",
  "to": "now"
 },
 "templating": {
  "list": [
   {
    "name": "datasource",
    "label": "Data source",
    "type": "datasource",
    "query": "prometheus",
    "hide": 0,
    "current": {},
    "refresh": 1
   }
  ]
 },
 "panels": [
  {
   "id": 17,
   "type": "row",
   "title": "At a glance",
   "collapsed": false,
   "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
   "panels": []
  },
  {
   "id": 18,
   "type": "stat",
   "title": "MQTT ingest",
   "description": "Zero means the broker link is dead. Every device report arrives this way.",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 4, "x": 0, "y": 1 },
   "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "area", "colorMode": "background" },
   "fieldConfig": {
    "defaults": {
     "unit": "ops",
     "decimals": 2,
     "noValue": "Down",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "red", "value": null },
       { "color": "green", "value": 0.01 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(home_gateway_mqtt_ingest_total_total[5m]))"
    }
   ]
  },
  {
   "id": 19,
   "type": "stat",
   "title": "Stale devices",
   "description": "Devices past their watchdog timeout and no longer reporting. See 'Time since last report' for which.",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 4, "x": 4, "y": 1 },
   "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "green", "value": null },
       { "color": "orange", "value": 1 },
       { "color": "red", "value": 3 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(home_gateway_device_stale) or vector(0)"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Workflow success (1h)",
   "description": "Share of workflow runs in the last hour that succeeded.",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 4, "x": 8, "y": 1 },
   "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 2,
     "noValue": "No runs",
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "red", "value": null },
       { "color": "yellow", "value": 0.9 },
       { "color": "green", "value": 0.99 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(home_gateway_workflows_total_total{outcome=\"success\"}[1h])) / (sum(increase(home_gateway_workflows_total_total[1h])) > 0)"
    }
   ]
  },
  {
   "id": 43,
   "type": "stat",
   "title": "Integrations failing",
   "description": "Integrations with at least one failed poll in the last 30m. See 'Integration poll outcomes' for which.",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 4, "x": 12, "y": 1 },
   "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "green", "value": null },
       { "color": "orange", "value": 1 },
       { "color": "red", "value": 2 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(sum by (integration) (increase(home_gateway_integration_polls_total_total{outcome=\"error\"}[30m])) > 0) or vector(0)"
    }
   ]
  },
  {
   "id": 20,
   "type": "stat",
   "title": "Reconciler give-ups (6h)",
   "description": "Commands abandoned after max_attempts: a device was told to do something and never did.",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 4, "x": 16, "y": 1 },
   "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "green", "value": null },
       { "color": "orange", "value": 1 },
       { "color": "red", "value": 5 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(home_gateway_reconciler_give_ups_total_total[6h])) or vector(0)"
    }
   ]
  },
  {
   "id": 21,
   "type": "stat",
   "title": "Actor restarts (1h)",
   "description": "A sustained non-zero value is a supervised actor in a crash loop.",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 4, "x": 20, "y": 1 },
   "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "green", "value": null },
       { "color": "orange", "value": 1 },
       { "color": "red", "value": 5 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(home_gateway_actor_restarts_total_total[1h])) or vector(0)"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Low battery (<20%)",
   "description": "Devices whose battery is under 20%. See 'Device battery percent' for which.",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 4, "x": 0, "y": 5 },
   "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "green", "value": null },
       { "color": "orange", "value": 1 },
       { "color": "red", "value": 3 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "count(max by (device_id) (home_gateway_device_battery_percent) < 20) or vector(0)"
    }
   ]
  },
  {
   "id": 1,
   "type": "stat",
   "title": "Workflow step errors (1h)",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 4, "x": 4, "y": 5 },
   "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "green", "value": null },
       { "color": "orange", "value": 1 },
       { "color": "red", "value": 5 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(home_gateway_workflow_steps_total_total{outcome=\"error\"}[1h])) or vector(0)"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "Device handler errors (1h)",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 4, "x": 8, "y": 5 },
   "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "green", "value": null },
       { "color": "orange", "value": 1 },
       { "color": "red", "value": 10 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(home_gateway_device_handler_errors_total_total[1h])) or vector(0)"
    }
   ]
  },
  {
   "id": 44,
   "type": "stat",
   "title": "DB query errors (1h)",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 4, "x": 12, "y": 5 },
   "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "green", "value": null },
       { "color": "orange", "value": 1 },
       { "color": "red", "value": 10 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(home_gateway_db_queries_total_total{outcome=\"error\"}[1h])) or vector(0)"
    }
   ]
  },
  {
   "id": 45,
   "type": "stat",
   "title": "Actor RPC errors (1h)",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 4, "x": 16, "y": 5 },
   "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "green", "value": null },
       { "color": "orange", "value": 1 },
       { "color": "red", "value": 10 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(home_gateway_rpc_errors_total_total[1h])) or vector(0)"
    }
   ]
  },
  {
   "id": 46,
   "type": "stat",
   "title": "Span error ratio (15m)",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 4, "w": 4, "x": 20, "y": 5 },
   "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "graphMode": "none", "colorMode": "background" },
   "fieldConfig": {
    "defaults": {
     "unit": "percentunit",
     "decimals": 2,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "green", "value": null },
       { "color": "orange", "value": 0.01 },
       { "color": "red", "value": 0.05 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "(sum(rate(traces_spanmetrics_calls_total{service=\"home-gateway\", status_code=\"STATUS_CODE_ERROR\"}[15m])) or vector(0)) / clamp_min(sum(rate(traces_spanmetrics_calls_total{service=\"home-gateway\"}[15m])), 0.0001)"
    }
   ]
  },
  {
   "id": 47,
   "type": "row",
   "title": "Devices",
   "collapsed": false,
   "gridPos": { "h": 1, "w": 24, "x": 0, "y": 9 },
   "panels": []
  },
  {
   "id": 23,
   "type": "table",
   "title": "Time since last report",
   "description": "Worst first. Devices climbing here are about to trip the watchdog.",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 10 },
   "transformations": [
    {
     "id": "organize",
     "options": {
      "excludeByName": {
       "Time": true,
       "__name__": true,
       "instance": true,
       "job": true,
       "namespace": true,
       "pod": true,
       "service": true,
       "container": true,
       "endpoint": true,
       "otel_scope_name": true,
       "otel_scope_version": true
      },
      "renameByName": { "device_id": "Device", "Value": "Silent for" }
     }
    }
   ],
   "fieldConfig": {
    "defaults": { "unit": "s" },
    "overrides": [
     {
      "matcher": { "id": "byName", "options": "Silent for" },
      "properties": [
       { "id": "custom.cellOptions", "value": { "type": "color-background", "mode": "gradient" } },
       {
        "id": "thresholds",
        "value": {
         "mode": "absolute",
         "steps": [
          { "color": "green", "value": null },
          { "color": "orange", "value": 900 },
          { "color": "red", "value": 1800 }
         ]
        }
       }
      ]
     }
    ]
   },
   "options": { "sortBy": [{ "displayName": "Silent for", "desc": true }] },
   "targets": [
    {
     "refId": "A",
     "expr": "home_gateway_device_last_seen_age_seconds",
     "instant": true,
     "format": "table"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "Device battery percent",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 12, "y": 10 },
   "fieldConfig": {
    "defaults": {
     "unit": "percent",
     "min": 0,
     "max": 100,
     "thresholds": {
      "mode": "absolute",
      "steps": [
       { "color": "red", "value": null },
       { "color": "yellow", "value": 20 },
       { "color": "green", "value": 40 }
      ]
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "max by (device_id, kind) (home_gateway_device_battery_percent)",
     "legendFormat": "{{device_id}} ({{kind}})"
    }
   ]
  },
  {
   "id": 16,
   "type": "timeseries",
   "title": "MQTT ingest by topic kind",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 18 },
   "fieldConfig": {
    "defaults": { "unit": "ops" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (topic_kind) (rate(home_gateway_mqtt_ingest_total_total[5m]))",
     "legendFormat": "{{topic_kind}}"
    }
   ]
  },
  {
   "id": 25,
   "type": "timeseries",
   "title": "Device handler errors",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 12, "y": 18 },
   "fieldConfig": {
    "defaults": { "unit": "ops" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (handler) (rate(home_gateway_device_handler_errors_total_total[15m]))",
     "legendFormat": "{{handler}}"
    }
   ]
  },
  {
   "id": 22,
   "type": "timeseries",
   "title": "Reconciler retries vs give-ups",
   "description": "A retry re-drives an unconfirmed command; a give-up means it never landed.",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 26 },
   "fieldConfig": {
    "defaults": { "unit": "ops" },
    "overrides": [
     {
      "matcher": { "id": "byRegexp", "options": "give-up.*" },
      "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }]
     }
    ]
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (kind) (rate(home_gateway_reconciler_retries_total_total[15m]))",
     "legendFormat": "retry {{kind}}"
    },
    {
     "refId": "B",
     "expr": "sum by (kind) (rate(home_gateway_reconciler_give_ups_total_total[15m]))",
     "legendFormat": "give-up {{kind}}"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "E-ink wake drift (p95)",
   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 12, "y": 26 },
   "fieldConfig": {
    "defaults": { "unit": "s" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum by (le, device_id) (rate(home_gateway_eink_wake_drift_seconds_bucket[15m])))",
     "legendFormat": "{{device_id}}"
    }
   ]
  },
  {
   "id": 48,
   "type": "row",
   "title": "Automation",
   "collapsed": false,
   "gridPos": { "h": 1, "w": 24, "x": 0, "y": 34 },
