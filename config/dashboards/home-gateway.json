   "datasource": { "type": "prometheus", "uid": "${datasource}" },
   "gridPos": { "h": 8, "w": 12, "x": 0, "y": 43 },
   "fieldConfig": {
    "defaults": { "unit": "ops" },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome) (rate(home_gateway_workflows_total_total[5m]))",
     "legendFormat": "{{outcome}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Workflow duration (p50 / p95)",
