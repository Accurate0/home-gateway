{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_RawDevice",
  "type": "array",
  "items": {
    "$ref": "#/$defs/RawDevice"
  },
  "$defs": {
    "RawDevice": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/EnabledState"
        },
        "transport": {
          "$ref": "#/$defs/RawTransport"
        },
        "model": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DeviceConfig"
          }
        },
        "watchdog": {
          "anyOf": [
            {
              "$ref": "#/$defs/RawDeviceWatchdog"
            },
            {
              "type": "null"
            }
          ]
        },
        "room": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "state",
        "transport",
        "roles"
      ]
    },
    "EnabledState": {
      "type": "string",
      "enum": [
        "enabled",
        "disabled"
      ]
    },
    "RawTransport": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "address": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "mqtt"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "address"
          ]
        },
        {
          "type": "object",
          "properties": {
            "address": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "esphome_native_api"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "address"
          ]
        },
        {
          "type": "object",
          "properties": {
            "address": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "eink_display_firmware"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "address"
          ]
        },
        {
          "type": "object",
          "properties": {
            "address": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "trmnl"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "address"
          ]
        },
        {
          "type": "object",
          "properties": {
            "address": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "home_assistant"
            }
          },
          "additionalProperties": false,
          "required": [
            "type",
            "address"
          ]
        }
      ]
    },
    "DeviceConfig": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "door"
            },
            "config": {
              "$ref": "#/$defs/RawDoorSettings"
            }
          },
          "required": [
            "type",
            "config"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "presence"
            },
            "config": {
              "$ref": "#/$defs/RawPresenceBlock"
            }
          },
          "required": [
            "type",
            "config"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "environment"
            },
            "config": {
              "$ref": "#/$defs/RawEnvironmentBlock"
            }
          },
          "required": [
            "type",
            "config"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "plant"
            },
            "config": {
              "$ref": "#/$defs/RawPlantBlock"
            }
          },
          "required": [
            "type",
            "config"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "light"
            },
            "config": {
              "$ref": "#/$defs/RawLightBlock"
            }
          },
          "required": [
            "type",
            "config"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "control_switch"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "smart_switch"
            },
            "config": {
              "$ref": "#/$defs/RawSmartSwitchBlock"
            }
          },
          "required": [
            "type",
            "config"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "eink_display_firmware"
            },
            "config": {
              "$ref": "#/$defs/RawEinkDisplayBlock"
            }
          },
          "required": [
            "type",
            "config"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "trmnl"
            },
            "config": {
              "$ref": "#/$defs/RawTrmnlBlock"
            }
          },
          "required": [
            "type",
            "config"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "robot_vacuum"
            },
            "config": {
              "$ref": "#/$defs/RawRobotVacuumBlock"
            }
          },
          "required": [
            "type",
            "config"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "media_player"
            },
            "config": {
              "$ref": "#/$defs/RawMediaPlayerBlock"
            }
          },
          "required": [
            "type",
            "config"
          ]
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "battery"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "RawDoorSettings": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "id": {
          "type": "string"
        },
        "notify": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NotifyRef"
          }
        }
      },
      "required": [
        "name",
        "id"
      ],
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "timeout": {
              "type": "string"
            },
            "state": {
              "type": "string",
              "const": "armed"
            }
          },
          "required": [
            "state",
            "timeout"
          ]
        },
        {
          "type": "object",
          "properties": {
            "state": {
              "type": "string",
              "const": "unarmed"
            }
          },
          "required": [
            "state"
          ]
        }
      ]
    },
    "NotifyRef": {
      "description": "A reference to a notify destination: either the name of a target declared\nunder `notify.targets:`, or an inline source.",
      "anyOf": [
        {
          "type": "string"
        },
        {
          "$ref": "#/$defs/NotifySource"
        }
      ]
    },
    "NotifySource": {
      "oneOf": [
        {
          "description": "Push notification to all registered HomeGateway Android devices.",
          "type": "object",
          "properties": {
            "type": {
              "type": "string",
              "const": "android_app"
            }
          },
          "required": [
            "type"
          ]
        }
      ]
    },
    "RawPresenceBlock": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "RawEnvironmentBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "additionalProperties": false,
      "required": [
        "id"
      ]
    },
    "RawPlantBlock": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name"
      ]
    },
    "RawLightBlock": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "RawSmartSwitchBlock": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "as": {
          "anyOf": [
            {
              "$ref": "#/$defs/SwitchRole"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "name"
      ]
    },
    "SwitchRole": {
      "type": "string",
      "enum": [
        "light"
      ]
    },
    "RawEinkDisplayBlock": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/RawEinkMode"
        },
        "orientation": {
          "anyOf": [
            {
              "$ref": "#/$defs/Orientation"
            },
            {
              "type": "null"
            }
          ]
        },
        "refresh": {
          "$ref": "#/$defs/CronSchedule"
        },
        "grace": {
          "type": "string"
        },
        "sleep": {
          "anyOf": [
            {
              "$ref": "#/$defs/RawSleepWindow"
            },
            {
              "type": "null"
            }
          ]
        },
        "partial": {
          "$ref": "#/$defs/RawPartialRefresh"
        }
      },
      "required": [
        "name",
        "mode",
        "refresh",
        "grace",
        "partial"
      ]
    },
    "RawEinkMode": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "view": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "settle": {
              "type": "string"
            },
            "lead": {
              "type": "string"
            },
            "name": {
              "type": "string",
              "const": "dashboard"
            }
          },
          "required": [
            "name",
            "settle",
            "lead"
          ]
        },
        {
          "type": "object",
          "properties": {
            "album": {
              "type": [
                "string",
                "null"
              ],
              "default": null
            },
            "name": {
              "type": "string",
              "const": "album"
            }
          },
          "required": [
            "name"
          ]
        },
        {
          "type": "object",
          "properties": {
            "subreddit": {
              "type": "string"
            },
            "timespan": {
              "$ref": "#/$defs/RedditTimespan"
            },
            "limit": {
              "type": "integer",
              "format": "uint32",
              "minimum": 0
            },
            "name": {
              "type": "string",
              "const": "reddit"
            }
          },
          "required": [
            "name",
            "subreddit",
            "timespan",
            "limit"
          ]
        }
      ]
    },
    "RedditTimespan": {
      "type": "string",
      "enum": [
        "hour",
        "day",
        "week",
        "month",
        "year",
        "all"
      ]
    },
    "Orientation": {
      "type": "string",
      "enum": [
        "portrait",
        "landscape"
      ]
    },
    "CronSchedule": {
      "description": "Deserialized straight from a cron string by croner's `serde` feature, so the\nconfig accepts the full readable syntax: day/month aliases (`THU`, `JAN`),\nnicknames (`@weekly`, `@daily`), ranges (`MON-FRI`) and steps (`*/15`).",
      "type": "string"
    },
    "RawSleepWindow": {
      "type": "object",
      "properties": {
        "start": {
          "type": "string"
        },
        "end": {
          "type": "string"
        }
      },
      "required": [
        "start",
        "end"
      ]
    },
    "RawPartialRefresh": {
      "type": "object",
      "properties": {
        "state": {
          "$ref": "#/$defs/EnabledState"
        },
        "max_area_pct": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "max_consecutive": {
          "type": "integer",
          "format": "int32"
        }
      },
      "required": [
        "state",
        "max_area_pct",
        "max_consecutive"
      ]
    },
    "RawTrmnlBlock": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "RawRobotVacuumBlock": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name"
      ]
    },
    "RawMediaPlayerBlock": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        }
      },
      "required": [
        "name"
      ]
    },
    "RawDeviceWatchdog": {
      "type": "object",
      "properties": {
        "timeout": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "notify": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NotifyRef"
          }
        }
      }
    }
  }
}
