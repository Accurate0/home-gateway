{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Array_of_WorkflowDefinition",
  "type": "array",
  "items": {
    "$ref": "#/$defs/WorkflowDefinition"
  },
  "$defs": {
    "WorkflowDefinition": {
      "anyOf": [
        {
          "$ref": "#/$defs/Workflow"
        },
        {
          "$ref": "#/$defs/ReusableWorkflow"
        }
      ]
    },
    "Workflow": {
      "type": "object",
      "properties": {
        "slug": {
          "type": "string",
          "default": ""
        },
        "name": {
          "type": "string",
          "default": ""
        },
        "group": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "enabled": {
          "type": "boolean",
          "default": true
        },
        "dry_run": {
          "type": "boolean",
          "default": false
        },
        "context": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContextSource"
          }
        },
        "inputs": {
          "type": [
            "object",
            "null"
          ],
          "additionalProperties": {
            "$ref": "#/$defs/VarType"
          },
          "default": null
        },
        "run": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Step"
          }
        },
        "on": {
          "$ref": "#/$defs/TriggerMatcher"
        },
        "modes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Mode"
          }
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/Condition"
            },
            {
              "type": "null"
            }
          ]
        },
        "cooldown": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "delay": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        },
        "for": {
          "type": [
            "string",
            "null"
          ],
          "default": null
        }
      },
      "required": [
        "run",
        "on",
        "modes"
      ]
    },
    "ContextSource": {
      "type": "string",
      "enum": [
        "fuelwatch",
        "willyweather"
      ]
    },
    "VarType": {
      "type": "string",
      "enum": [
        "string",
        "int",
        "float",
        "bool"
      ]
    },
    "Step": {
      "description": "A single workflow step: one action, optionally guarded by a `when` condition.\nNesting (the old `conditional` block) is expressed as a guarded `scene`.",
      "oneOf": [
        {
          "description": "Brightness / colour-temperature mutations applied to a light. Kept in\n`SCREAMING_SNAKE_CASE` to match the long-standing on-disk config.",
          "type": "object",
          "properties": {
            "device": {
              "type": "string"
            },
            "when": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Condition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "light"
            }
          },
          "required": [
            "type",
            "device"
          ],
          "oneOf": [
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "ON"
                }
              },
              "required": [
                "state"
              ]
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "OFF"
                }
              },
              "required": [
                "state"
              ]
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "TOGGLE"
                }
              },
              "required": [
                "state"
              ]
            },
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "state": {
                  "type": "string",
                  "const": "SET_BRIGHTNESS"
                }
              },
              "required": [
                "state",
                "value"
              ]
            },
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "on_off": {
                  "type": "boolean",
                  "default": false
                },
                "state": {
                  "type": "string",
                  "const": "INCREASE_BRIGHTNESS"
                }
              },
              "required": [
                "state",
                "value"
              ]
            },
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "on_off": {
                  "type": "boolean",
                  "default": false
                },
                "state": {
                  "type": "string",
                  "const": "DECREASE_BRIGHTNESS"
                }
              },
              "required": [
                "state",
                "value"
              ]
            },
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "state": {
                  "type": "string",
                  "const": "INCREASE_COLOUR_TEMPERATURE"
                }
              },
              "required": [
                "state",
                "value"
              ]
            },
            {
              "type": "object",
              "properties": {
                "value": {
                  "type": "integer",
                  "format": "uint64",
                  "minimum": 0
                },
                "state": {
                  "type": "string",
                  "const": "DECREASE_COLOUR_TEMPERATURE"
                }
              },
              "required": [
                "state",
                "value"
              ]
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "STOP_COLOUR_TEMPERATURE"
                }
              },
              "required": [
                "state"
              ]
            },
            {
              "type": "object",
              "properties": {
                "state": {
                  "type": "string",
                  "const": "STOP_BRIGHTNESS"
                }
              },
              "required": [
                "state"
              ]
            }
          ]
        },
        {
          "type": "object",
          "properties": {
            "device": {
              "type": "string"
            },
            "state": {
              "$ref": "#/$defs/SwitchState"
            },
            "when": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Condition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "switch"
            }
          },
          "required": [
            "type",
            "device",
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "run": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Step"
              }
            },
            "when": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Condition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "scene"
            }
          },
          "required": [
            "type",
            "run"
          ]
        },
        {
          "type": "object",
          "properties": {
            "notify": {
              "$ref": "#/$defs/NotifySource"
            },
            "message": {
              "type": "string"
            },
            "title": {
              "type": [
                "string",
                "null"
              ]
            },
            "category": {
              "$ref": "#/$defs/NotifyCategory"
            },
            "actions": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/NotifyAction"
              }
            },
            "acknowledge": {
              "anyOf": [
                {
                  "$ref": "#/$defs/NotifyAcknowledge"
                },
                {
                  "type": "null"
                }
              ]
            },
            "when": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Condition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "notify"
            }
          },
          "required": [
            "type",
            "notify",
            "message",
            "category"
          ]
        },
        {
          "type": "object",
          "properties": {
            "seconds": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "when": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Condition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "delay"
            }
          },
          "required": [
            "type",
            "seconds"
          ]
        },
        {
          "type": "object",
          "properties": {
            "workflow": {
              "type": "string"
            },
            "with": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "when": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Condition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "run_workflow"
            }
          },
          "required": [
            "type",
            "workflow",
            "with"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "$ref": "#/$defs/Mode"
            },
            "when": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Condition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "set_mode"
            }
          },
          "required": [
            "type",
            "mode"
          ]
        },
        {
          "type": "object",
          "properties": {
            "tag": {
              "type": "string"
            },
            "state": {
              "$ref": "#/$defs/EnableState"
            },
            "when": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Condition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "set_workflows_enabled"
            }
          },
          "required": [
            "type",
            "tag",
            "state"
          ]
        },
        {
          "type": "object",
          "properties": {
            "call_service": {
              "type": "string"
            },
            "data": {
              "default": null
            },
            "when": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Condition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "home_assistant"
            }
          },
          "required": [
            "type",
            "call_service"
          ]
        },
        {
          "type": "object",
          "properties": {
            "topic": {
              "type": "string"
            },
            "payload": {
              "type": "string"
            },
            "retain": {
              "type": "boolean"
            },
            "when": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Condition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "mqtt_publish"
            }
          },
          "required": [
            "type",
            "topic",
            "payload",
            "retain"
          ]
        },
        {
          "type": "object",
          "properties": {
            "method": {
              "$ref": "#/$defs/HttpMethod"
            },
            "url": {
              "type": "string"
            },
            "headers": {
              "type": "object",
              "additionalProperties": {
                "type": "string"
              }
            },
            "body": {
              "type": [
                "string",
                "null"
              ]
            },
            "when": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Condition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "http"
            }
          },
          "required": [
            "type",
            "method",
            "url"
          ]
        },
        {
          "type": "object",
          "properties": {
            "device": {
              "type": "string"
            },
            "command": {
              "$ref": "#/$defs/VacuumCommand"
            },
            "when": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Condition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "robot_vacuum"
            }
          },
          "required": [
            "type",
            "device",
            "command"
          ]
        },
        {
          "type": "object",
          "properties": {
            "returns": {
              "type": "object",
              "additionalProperties": {
                "$ref": "#/$defs/VarType"
              }
            },
            "when": {
              "anyOf": [
                {
                  "$ref": "#/$defs/Condition"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": {
              "type": "string",
              "const": "lua"
            }
          },
          "anyOf": [
            {
              "type": "object",
              "properties": {
                "script": {
                  "type": "string"
                }
              },
              "required": [
                "script"
              ]
            },
            {
              "type": "object",
              "properties": {
                "call": {
                  "type": "string"
                },
                "args": {
                  "type": "array",
                  "items": true,
                  "default": []
                }
              },
              "required": [
                "call"
              ]
            }
          ],
          "required": [
            "type",
            "returns"
          ]
        }
      ]
    },
    "Condition": {
      "description": "A boolean predicate evaluated against current device/sensor state. Either a\nnested boolean combinator (`all`/`and`, `any`/`or`, `not`) or a leaf test.",
      "anyOf": [
        {
          "$ref": "#/$defs/Combinator"
        },
        {
          "$ref": "#/$defs/LeafCondition"
        }
      ]
    },
    "Combinator": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "all": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          "required": [
            "all"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "any": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Condition"
              }
            }
          },
          "required": [
            "any"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "not": {
              "$ref": "#/$defs/Condition"
            }
          },
          "required": [
            "not"
          ],
          "additionalProperties": false
        }
      ]
    },
    "LeafCondition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "device": {
              "type": "string"
            },
            "on": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "light"
            }
          },
          "required": [
            "type",
            "device",
            "on"
          ]
        },
        {
          "description": "A scalar comparison: `{ op: gt, value: 30 }`. Flattened into the\n[`super::LeafCondition::Environment`] variant.",
          "type": "object",
          "properties": {
            "sensor": {
              "type": "string"
            },
            "metric": {
              "$ref": "#/$defs/EnvMetric"
            },
            "op": {
              "$ref": "#/$defs/CompareOp"
            },
            "value": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "environment"
            }
          },
          "required": [
            "type",
            "sensor",
            "metric",
            "op",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "sensor": {
              "type": "string"
            },
            "present": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "presence"
            }
          },
          "required": [
            "type",
            "sensor",
            "present"
          ]
        },
        {
          "type": "object",
          "properties": {
            "device": {
              "type": "string"
            },
            "open": {
              "type": "boolean"
            },
            "type": {
              "type": "string",
              "const": "door"
            }
          },
          "required": [
            "type",
            "device",
            "open"
          ]
        },
        {
          "type": "object",
          "properties": {
            "after": {
              "type": [
                "string",
                "null"
              ],
              "format": "partial-time",
              "default": null
            },
            "before": {
              "type": [
                "string",
                "null"
              ],
              "format": "partial-time",
              "default": null
            },
            "type": {
              "type": "string",
              "const": "time_of_day"
            }
          },
          "required": [
            "type"
          ]
        },
        {
          "type": "object",
          "properties": {
            "is": {
              "$ref": "#/$defs/SunPeriod"
            },
            "offset": {
              "type": "string",
              "default": [
                0,
                0
              ]
            },
            "type": {
              "type": "string",
              "const": "sun"
            }
          },
          "required": [
            "type",
            "is"
          ]
        },
        {
          "type": "object",
          "properties": {
            "is": {
              "$ref": "#/$defs/Mode"
            },
            "type": {
              "type": "string",
              "const": "mode"
            }
          },
          "required": [
            "type",
            "is"
          ]
        },
        {
          "description": "A scalar comparison: `{ op: gt, value: 30 }`. Flattened into the\n[`super::LeafCondition::Environment`] variant.",
          "type": "object",
          "properties": {
            "metric": {
              "$ref": "#/$defs/SolarMetric"
            },
            "op": {
              "$ref": "#/$defs/CompareOp"
            },
            "value": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "solar"
            }
          },
          "required": [
            "type",
            "metric",
            "op",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "entity_id": {
              "type": "string"
            },
            "state": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "home_assistant"
            }
          },
          "required": [
            "type",
            "entity_id",
            "state"
          ]
        },
        {
          "description": "A scalar comparison: `{ op: gt, value: 30 }`. Flattened into the\n[`super::LeafCondition::Environment`] variant.",
          "type": "object",
          "properties": {
            "device": {
              "type": "string"
            },
            "metric": {
              "$ref": "#/$defs/SwitchMetric"
            },
            "op": {
              "$ref": "#/$defs/CompareOp"
            },
            "value": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "smart_switch"
            }
          },
          "required": [
            "type",
            "device",
            "metric",
            "op",
            "value"
          ]
        },
        {
          "description": "A scalar comparison: `{ op: gt, value: 30 }`. Flattened into the\n[`super::LeafCondition::Environment`] variant.",
          "type": "object",
          "properties": {
            "source": {
              "$ref": "#/$defs/WeatherSource"
            },
            "metric": {
              "$ref": "#/$defs/WeatherMetric"
            },
            "day": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ForecastDay"
                },
                {
                  "type": "null"
                }
              ]
            },
            "op": {
              "$ref": "#/$defs/CompareOp"
            },
            "value": {
              "type": "number",
              "format": "double"
            },
            "type": {
              "type": "string",
              "const": "weather"
            }
          },
          "required": [
            "type",
            "source",
            "metric",
            "op",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "var": {
              "type": "string"
            },
            "op": {
              "$ref": "#/$defs/CompareOp"
            },
            "value": {
              "$ref": "#/$defs/Literal"
            },
            "type": {
              "type": "string",
              "const": "var"
            }
          },
          "required": [
            "type",
            "var",
            "op",
            "value"
          ]
        },
        {
          "type": "object",
          "properties": {
            "script": {
              "type": "string"
            },
            "type": {
              "type": "string",
              "const": "lua"
            }
          },
          "required": [
            "type",
            "script"
          ]
        }
      ]
    },
    "EnvMetric": {
      "description": "Which reading of an environment sensor a condition compares against.",
      "type": "string",
      "enum": [
        "temperature",
        "humidity",
        "pressure",
        "lux",
        "uv_index"
      ]
    },
    "CompareOp": {
      "type": "string",
      "enum": [
        "gt",
        "lt",
        "gte",
        "lte",
        "eq"
      ]
    },
    "SunPeriod": {
      "type": "string",
      "enum": [
        "day",
        "night"
      ]
    },
    "Mode": {
      "type": "string",
      "enum": [
        "home",
        "away",
        "vacation",
        "guest"
      ]
    },
    "SolarMetric": {
      "type": "string",
      "enum": [
        "current",
        "avg_15m",
        "avg_1h",
        "avg_3h"
      ]
    },
    "SwitchMetric": {
      "type": "string",
      "enum": [
        "power",
        "voltage",
        "current",
        "energy"
      ]
    },
    "WeatherSource": {
      "type": "string",
      "enum": [
        "bom",
        "willyweather"
      ]
    },
    "WeatherMetric": {
      "type": "string",
      "enum": [
        "temperature",
        "feels_like",
        "humidity",
        "wind_speed",
