---
source: src/graphql/mod.rs
expression: "&sdl"
---
type AdhocCronTaskStatus {
	id: String!
	name: String!
	schedule: String!
	flag: String
	nextRunAt: DateTime
	lastRunAt: DateTime
	durationMs: Int
	rowsAffected: Int
	outcome: String
}

type AdhocTaskStatus {
	id: String!
	ordinal: Int!
	name: String!
	flag: String
	completedAt: DateTime
	durationMs: Int
	pending: Boolean!
	checksumDrifted: Boolean!
}

type AuthObject {
	id: String
	name: String
	scopes: [String!]!
}

enum BatteryChemistry {
	UNKNOWN
	LIPO
	LI_ION
	ALKALINE
	CR_2032
}

type BatteryPoint {
	batteryVoltage: Float
	batteryPercent: Float
	time: DateTime!
	batteryPercentage: Float
}

input BrightnessMoveInput {
	value: Int!
	onOff: Boolean!
}

enum Capability {
	BRIGHTNESS
	COLOUR_TEMP
	RGB
	TEMPERATURE
	HUMIDITY
	PRESSURE
	LUX
	UV_INDEX
	PM_25
	VOC_INDEX
}

input ColourTemperatureMoveInput {
	value: Int!
}

type CronUpdate {
	eventId: UUID!
	name: String!
}

"""
Implement the DateTime<Utc> scalar

The input/output is a string in RFC3339 format.
"""
scalar DateTime

type DepartureObject {
	line: String!
	headsign: String!
	platform: String
	scheduledDeparture: DateTime!
	liveDeparture: DateTime
	delayMinutes: Int
	minutesAway: Int!
	live: Boolean!
}

type DeviceBattery {
	kind: String!
	voltage: Float
	chemistry: BatteryChemistry!
	percentage: Float
	updatedAt: DateTime!
	history(since: DateTime!): [BatteryPoint!]!
}

type DeviceBatteryUpdate {
	eventId: UUID!
	"""
	Config slug, matching the `id` from the `entities` query.
	"""
	id: ID!
	name: String!
	kind: String!
	batteryVoltage: Float
	batteryPercent: Float
	batteryPercentage: Float
}

type DoorEntity {
	category: EntityCategory!
	id: String!
	name: String!
	capabilities: [Capability!]!
	room: String
	battery: DeviceBattery
	"""
	Whether the door is open. Nullable so an unreachable door-events actor
	reports the error against this field without nulling the whole entity.
	"""
	open: Boolean
	lastSeen: DateTime
}

type DoorUpdate {
	eventId: UUID!
	"""
	Config slug, matching the `id` from the `entities` query.
	"""
	id: ID!
	"""
	Human-friendly name, matching the `entities` query.
	"""
	name: String!
	"""
	Raw device address the event was emitted for.
	"""
	device: String!
	open: Boolean!
}

type EinkDisplayConfig {
	mode: EinkMode!
	view: String
	album: String
	subreddit: String
	timespan: RedditTimespan
	limit: Int
	orientation: Orientation!
	refresh: String!
	grace: String!
	settle: String
	lead: String
	sleepStart: String
	sleepEnd: String
}

type EinkDisplayEntity {
	category: EntityCategory!
	id: String!
	name: String!
	kind: EinkDisplayKind!
	capabilities: [Capability!]!
	room: String
	batteryVoltage: Float
	batteryPercentage: Float
	isCharging: Boolean
	lastSeen: DateTime
	config: EinkDisplayConfig
	deviceConfig: EpdConfig!
	battery: DeviceBattery
	batteryHistory(since: DateTime!): [BatteryPoint!]!
}

enum EinkDisplayKind {
	TRMNL
	EINK_DISPLAY_FIRMWARE
}

type EinkDisplayMutation {
	takeScreenshot: Boolean!
}

enum EinkMode {
	DASHBOARD
	ALBUM
	REDDIT
}

type EnergyConsumption {
	id: UUID!
	used: Float!
	solarExported: Float!
	time: DateTime!
}

input EnergyHistoryInput {
	since: DateTime!
}

type EnergyObject {
	history(input: EnergyHistoryInput!): [EnergyConsumption!]!
}

union Entity = LightEntity | EnvironmentEntity | DoorEntity | PresenceEntity | EinkDisplayEntity | RobotVacuumEntity | MediaPlayerEntity

"""
The dashboard section a device kind is displayed under. Owned by the backend
so categorising a kind never requires a frontend change. Variants are declared
in display order — see [`EntityCategory::ORDERED`].
"""
enum EntityCategory {
	LIGHTS
	DOORS
	PRESENCE
	ENVIRONMENT
	DISPLAYS
	VACUUMS
	MEDIA
}

type EntitySection {
	category: EntityCategory!
	title: String!
}

type EnvironmentEntity {
	category: EntityCategory!
	id: String!
	name: String!
	capabilities: [Capability!]!
	room: String
	battery: DeviceBattery
	"""
	Nullable so a missing reading reports the error against this field
	without nulling the whole entity.
	"""
	temperature: Float
	humidity: Float
	pressure: Float
	lux: Float
	uvIndex: Float
	"""
	Nullable so a missing reading reports the error against this field
	without nulling the whole entity.
	"""
	time: DateTime
	lastSeen: DateTime
}

type EnvironmentUpdate {
	eventId: UUID!
	"""
	Config slug, matching the `id` from the `entities` query.
	"""
	id: ID!
	"""
	Human-friendly name, matching the `entities` query.
	"""
	name: String!
	"""
	Raw device address the event was emitted for.
	"""
	sensor: String!
	readings: [MetricReading!]!
}

type EpdConfig {
	refreshIntervalMins: Int
	refreshIntervalSecs: Int
	imageUrl: String
	imageHash: String
	clearScreen: Boolean
	firmwareUrl: String
	firmwareVersion: String
	partial: PartialWindow
}

union EventUpdate = PresenceUpdate | DoorUpdate | SwitchUpdate | EnvironmentUpdate | CronUpdate | SunUpdate | LightUpdate | UnifiUpdate | ModeUpdate | HomeAssistantUpdate | WoolworthsUpdate | DeviceBatteryUpdate | JellyfinUpdate | MediaPlayerUpdate | SolarUpdate

type Forecast {
	days: [ForecastDetails!]!
}

type ForecastDetails {
	dateTime: String!
	code: String!
	description: String!
	emoji: String!
	min: Int!
	max: Int!
	uv: Float
}

type FuelSite {
	name: String!
	brand: String!
	suburb: String!
	postcode: Int!
	address: String!
	price: Float!
	priceTomorrow: Float
	latitude: Float!
	longitude: Float!
}

type FuelWatchObject {
	cheapest: FuelSite
	sites(limit: Int): [FuelSite!]!
}

type GenerationHistory {
	wh: Float!
	at: NaiveDateTime!
	uvLevel: Float
	temperature: Float
	timestamp: Int!
}

type HomeAssistantEvent {
	eventId: UUID!
	entityId: String!
	state: String!
	time: DateTime!
	id: ID!
}

type HomeAssistantObject {
	entities: [HomeAssistantEvent!]!
}

type HomeAssistantUpdate {
	eventId: UUID!
	entityId: String!
	state: String!
	id: ID!
}

type JellyfinObject {
	nowPlaying: [JellyfinSession!]!
}

type JellyfinSession {
	eventId: UUID!
	sessionId: String!
	user: String!
	device: String!
	client: String!
	itemId: String!
	itemName: String!
	itemType: String!
	seriesName: String
	season: Int
	episode: Int
	positionSeconds: Float
	runtimeSeconds: Float
	playMethod: String
	paused: Boolean!
	updatedAt: DateTime!
	id: ID!
	progress: Float
}

type JellyfinUpdate {
	eventId: UUID!
	state: String!
	sessionId: String!
	user: String!
	device: String!
	client: String!
	itemId: String!
	itemName: String!
	itemType: String!
	seriesName: String
	season: Int
	episode: Int
	positionSeconds: Float
	runtimeSeconds: Float
	playMethod: String
	id: ID!
}

type LightEntity {
	category: EntityCategory!
	id: String!
	name: String!
	capabilities: [Capability!]!
	room: String
	battery: DeviceBattery
	"""
	Current power state. Nullable so an unreachable light actor reports the
	error against this field without nulling the whole entity.
	"""
	on: Boolean
	lastSeen: DateTime
}

type LightMutation {
	on: Boolean!
	off: Boolean!
	toggle: Boolean!
	setBrightness(input: SetBrightnessInput!): Boolean!
	brightnessMove(input: BrightnessMoveInput!): Boolean!
	setColour(input: SetColourInput!): Boolean!
	colourTemperatureMove(input: ColourTemperatureMoveInput!): Boolean!
}

type LightUpdate {
	eventId: UUID!
	"""
	Config slug, matching the `id` from the `entities` query.
	"""
	id: ID!
	"""
	Human-friendly name, matching the `entities` query.
	"""
	name: String!
	"""
	Raw device address the event was emitted for.
	"""
	device: String!
	on: Boolean!
}

type MediaPlayerEntity {
	category: EntityCategory!
	id: String!
	name: String!
	room: String
	state: String
	playing: Boolean!
	appName: String
	source: String
	mediaContentType: String
	mediaTitle: String
	mediaArtist: String
	mediaAlbumName: String
	mediaSeriesTitle: String
	season: Int
	episode: Int
	durationSeconds: Float
	"""
	Where playback has reached now, extrapolated from the last reported
	position: Home Assistant only republishes `media_position` on a seek, so a
	stored value goes stale the moment it lands.
	"""
	positionSeconds: Float
	progress: Float
	volumeLevel: Float
	muted: Boolean
	artworkUrl: String
	lastSeen: DateTime
}

type MediaPlayerMutation {
	play: Boolean!
	pause: Boolean!
	playPause: Boolean!
	stop: Boolean!
	next: Boolean!
	previous: Boolean!
	volumeSet(level: Float!): Boolean!
	mute(muted: Boolean!): Boolean!
	turnOff: Boolean!
}

type MediaPlayerUpdate {
	eventId: UUID!
	deviceId: String!
	name: String!
	room: String
	state: String!
	entityState: String!
	appName: String
	source: String
	mediaTitle: String
	mediaSeriesTitle: String
	mediaContentType: String
	season: Int
	episode: Int
	positionSeconds: Float
	durationSeconds: Float
	volumeLevel: Float
	muted: Boolean
	artworkUrl: String
	id: ID!
}

type MetricReading {
	metric: String!
	value: Float!
}

enum Mode {
	HOME
	AWAY
	VACATION
	NIGHT
	GUEST
	PARTY
}

type ModeUpdate {
	eventId: UUID!
	mode: Mode!
	active: Boolean!
}

type MutationRoot {
	light(id: String!): LightMutation!
	robotVacuum(id: String!): RobotVacuumMutation!
	mediaPlayer(id: String!): MediaPlayerMutation!
	einkDisplay(id: String!): EinkDisplayMutation!
	setWorkflowEnabled(slug: String!, enabled: Boolean!): Boolean!
	setMode(mode: Mode!, active: Boolean!): [Mode!]!
	setGuestMode(active: Boolean!): Boolean! @deprecated(reason: "use setMode(mode: GUEST, active: ...) instead")
	runPendingAdhocTasks: Boolean!
	runAdhocCronTask(name: String!): Boolean!
}

"""
ISO 8601 combined date and time without timezone.

# Examples

* `2015-07-01T08:59:60.123`,
"""
scalar NaiveDateTime

enum Orientation {
	PORTRAIT
	LANDSCAPE
}

type PartialWindow {
	x: Int!
	y: Int!
	width: Int!
	height: Int!
}

type PresenceEntity {
	category: EntityCategory!
	id: String!
	name: String!
	capabilities: [Capability!]!
	room: String
	battery: DeviceBattery
	"""
	Whether presence is detected. Nullable so an unreachable presence actor
	reports the error against this field without nulling the whole entity.
	"""
	present: Boolean
	lastSeen: DateTime
}

type PresenceUpdate {
	eventId: UUID!
	"""
	Config slug, matching the `id` from the `entities` query.
	"""
	id: ID!
	"""
	Human-friendly name, matching the `entities` query.
	"""
	name: String!
	"""
	Raw device address the event was emitted for.
	"""
	sensor: String!
	present: Boolean!
}

type QueryRoot {
	auth: AuthObject!
	homeAssistant: HomeAssistantObject!
	"""
	Every configured entity and its current state. Entity types the caller
	lacks a `graphql:<type>:read` scope for are silently omitted — this query
	never errors on missing permissions.
	The dashboard sections, in display order, with their titles. Categorising
	a device kind is a backend concern — the frontend renders whatever order
	and titles this returns.
	"""
	entitySections: [EntitySection!]!
	entities: [Entity!]!
	mediaPlayer(id: String!): MediaPlayerEntity!
	light(id: String!): LightEntity!
	door(id: String!): DoorEntity!
	presence(id: String!): PresenceEntity!
	environment(id: String!): EnvironmentEntity!
	einkDisplay(id: String!): EinkDisplayEntity!
	robotVacuum(id: String!): RobotVacuumEntity!
	solar: SolarObject!
	energy: EnergyObject!
	weather(input: WeatherInput!): WeatherObject!
	woolworths: WoolworthsObject!
	transperth: TransperthObject!
	fuelwatch(postcode: Int): FuelWatchObject!
	workflows: [WorkflowStatus!]!
	activeModes: [Mode!]!
	guestMode: Boolean! @deprecated(reason: "use activeModes / mode(GUEST) instead")
	workflowRuns(slug: String, limit: Int): [WorkflowRun!]!
	jellyfin: JellyfinObject!
	adhocCronTasks: [AdhocCronTaskStatus!]!
	adhocTasks: [AdhocTaskStatus!]!
}

enum RedditTimespan {
	HOUR
	DAY
	WEEK
	MONTH
	YEAR
	ALL
}

type RobotVacuumEntity {
	category: EntityCategory!
	id: String!
	name: String!
	room: String
	battery: DeviceBattery
	capabilities: [Capability!]!
	kind: RobotVacuumKind!
	status: String
	batteryPercentage: Float
	currentRoom: String
	fanSpeed: String
	currentCleanArea: Float
	cleanCount: Int
	lastSeen: DateTime
}

enum RobotVacuumKind {
	ROBOROCK
	VALETUDO
}

type RobotVacuumMutation {
	start: Boolean!
	stop: Boolean!
	dock: Boolean!
}

type RouteDeparturesObject {
	id: String!
	origin: String!
	destination: String!
	updatedAt: DateTime!
	stale: Boolean!
	departures: [DepartureObject!]!
}

input SetBrightnessInput {
	value: Int!
}

input SetColourInput {
	hex: String!
}

type SolarCurrentResponse {
	currentProductionWh: Float!
	todayProductionKwh: Float!
	yesterdayProductionKwh: Float!
	monthProductionKwh: Float!
	allTimeProductionKwh: Float!
	statistics: SolarCurrentStatistics!
	uvLevel: Float
	temperature: Float
}

type SolarCurrentStatistics {
	averages: SolarCurrentStatisticsAverages!
}

type SolarCurrentStatisticsAverages {
	last15Mins: Float
	last1Hour: Float
	last3Hours: Float
}

input SolarHistoryInput {
	since: DateTime!
}

type SolarObject {
	current: SolarCurrentResponse!
	history(input: SolarHistoryInput!): [GenerationHistory!]!
}

type SolarUpdate {
	eventId: UUID!
	currentWh: Float!
}

type SubscriptionRoot {
	events(filter: String! = "*"): EventUpdate!
}

type SunUpdate {
	eventId: UUID!
	transition: String!
}

type SwitchUpdate {
	eventId: UUID!
	device: String!
	action: String!
}

type TransperthObject {
	routes: [RouteDeparturesObject!]!
	route(id: String!): RouteDeparturesObject
}

"""
A UUID is a unique 128-bit number, stored as 16 octets. UUIDs are parsed as
Strings within GraphQL. UUIDs are used to assign unique identifiers to
entities without requiring a central allocating authority.

# References

* [Wikipedia: Universally Unique Identifier](http://en.wikipedia.org/wiki/Universally_unique_identifier)
* [RFC4122: A Universally Unique Identifier (UUID) URN Namespace](http://tools.ietf.org/html/rfc4122)
"""
scalar UUID

type UnifiUpdate {
	eventId: UUID!
	macAddress: String!
	client: String!
	connected: Boolean!
}

input WeatherInput {
	location: String!
}

type WeatherObject {
	forecast: Forecast!
}

type WoolworthsObject {
	products: [WoolworthsProducts!]!
	priceHistory(input: WoolworthsPriceHistoryInput!): [WoolworthsPricePoint!]!
}

input WoolworthsPriceHistoryInput {
	productId: Int!
	since: DateTime!
}

type WoolworthsPricePoint {
	productId: Int!
	name: String!
	price: Float!
	time: DateTime!
}

type WoolworthsProducts {
	name: String!
	price: Float!
}

type WoolworthsUpdate {
	eventId: UUID!
	productId: Int!
	name: String!
	oldPrice: Float!
	newPrice: Float!
}

type WorkflowRun {
	id: ID!
	slug: String!
	name: String!
	eventId: String!
	outcome: String!
	dryRun: Boolean!
	durationMs: Int!
	error: String
	startedAt: DateTime!
}

type WorkflowStatus {
	id: String!
	slug: String!
	name: String!
	group: String!
	tags: [String!]!
	enabled: Boolean!
	configEnabled: Boolean!
	dryRun: Boolean!
	reusable: Boolean!
}

"""
Marks an element of a GraphQL schema as no longer supported.
"""
directive @deprecated(reason: String = "No longer supported") on FIELD_DEFINITION | ARGUMENT_DEFINITION | INPUT_FIELD_DEFINITION | ENUM_VALUE
"""
Directs the executor to include this field or fragment only when the `if` argument is true.
"""
directive @include(if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT
"""
Directs the executor to skip this field or fragment when the `if` argument is true.
"""
directive @skip(if: Boolean!) on FIELD | FRAGMENT_SPREAD | INLINE_FRAGMENT
"""
Provides a scalar specification URL for specifying the behavior of custom scalar types.
"""
directive @specifiedBy(url: String!) on SCALAR
schema {
	query: QueryRoot
	mutation: MutationRoot
	subscription: SubscriptionRoot
}
